# Copia como .env.oracle, restringe sus permisos y nunca lo subas a Git.
POSTGRES_DB=boldapp
POSTGRES_USER=boldapp
POSTGRES_PASSWORD=REEMPLAZAR_CON_VALOR_ALEATORIO_URL_SAFE
REDIS_PASSWORD=REEMPLAZAR_CON_OTRO_VALOR_ALEATORIO_URL_SAFE

DJANGO_DEBUG=false
SECRET_KEY=REEMPLAZAR_CON_SECRETO_DJANGO_LARGO
AUTH_ENCRYPTION_KEY=REEMPLAZAR_CON_SECRETO_MFA_DISTINTO
ALLOWED_HOSTS=api.bold.gt
USE_X_FORWARDED_HOST=true
CORS_ALLOWED_ORIGINS=https://app.bold.gt
FRONTEND_URL=https://app.bold.gt
# Si OAuth ya está configurado en Administración, conservar su configuración y AUTH_ENCRYPTION_KEY.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_COMPANY_DOMAIN=bold.gt
# Callback publico del Worker: registrar esta URL exacta en el cliente OAuth corporativo.
GOOGLE_WORKSPACE_REDIRECT_URI=https://boldapp.boldapp-93b.workers.dev/api/v2/workspace/oauth/callback/
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.bold.gt/api/v2/calendar/oauth/callback/
HEALTHCHECK_HOST=api.bold.gt
TRUST_CLOUDFLARE_CONNECTING_IP=true
AUTH_NUM_PROXIES=0

AUTH_SESSION_COOKIE_NAME=bold_session
AUTH_SESSION_COOKIE_SAMESITE=Lax
AUTH_SESSION_TIME_ZONE=America/Guatemala
AUTH_SESSION_CUTOFF_TIME=07:00
AUTH_SESSION_IDLE_SECONDS=0
AUTH_MFA_REQUIRED=false
AUTH_CHALLENGE_TTL_SECONDS=3600
AUTH_INVITATION_TTL_SECONDS=259200
AUTH_WEBSOCKET_TICKET_TTL_SECONDS=45
ADMIN_STEP_UP_MFA_SECONDS=600
ADMIN_TEMPORARY_PASSWORD_ENABLED=false
PERMISSIONS_STEP_UP_MFA_SECONDS=600
PERMISSIONS_AUTHORITY_MAX_SECONDS=7776000
SEED_DEMO_ACCOUNTS=false
SEED_PRIVILEGED_DEMO_ACCOUNTS=false

# Secreto interno compartido por backend, worker y motor. No se publica en Cloudflare.
SHEETS_ENGINE_TOKEN=REEMPLAZAR_CON_SECRETO_ALEATORIO_DISTINTO
# Solo el cargo activo de las unidades IT indicadas podrá acceder a Sheets.
# Sin IDs el piloto no permite acceso, ni siquiera a propietarios fuera de IT.
SHEETS_PILOT_ENABLED=true
SHEETS_PILOT_UNIT_IDS=
MESSAGING_PILOT_ENABLED=true
# Local automations acceptance is not a production launch. Requires migration,
# current-permission acceptance and an explicitly authorized worker deployment.
MESSAGING_AUTOMATIONS_ENABLED=false
# Rules and durable audit/run records, including paused rules; no history purge.
MESSAGING_AUTOMATION_ACCOUNT_RULES=20
MESSAGING_AUTOMATION_MAX_RULES=200
MESSAGING_AUTOMATION_ACCOUNT_RECORDS=10000
MESSAGING_AUTOMATION_MAX_RECORDS=100000
MESSAGING_PILOT_UNIT_IDS=

# Presupuestos internos configurables (bytes), no cuota disponible de Google.
# Bytes temporales (cola cifrada + imágenes QR): 32 MiB por cuenta / 128 MiB total.
MESSAGING_UPLOAD_ACCOUNT_BYTES=33554432
MESSAGING_UPLOAD_QUEUE_BYTES=134217728
# Archivos de Chat/Slack, reservas y legado: 256 MiB por cuenta / 2 GiB total.
# Un archivo con ID remoto sigue contando aunque se concilie en Papelera.
MESSAGING_STORAGE_ACCOUNT_BYTES=268435456
MESSAGING_STORAGE_TOTAL_BYTES=2147483648
# Intentos, legado e imágenes QR: no se purgan nonces ni mensajes para dar espacio.
MESSAGING_UPLOAD_ACCOUNT_MAX_RECORDS=20000
MESSAGING_UPLOAD_MAX_RECORDS=100000

CELERY_TASK_ALWAYS_EAGER=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# Para recuperacion de contrasena configura un relay SMTP real.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=REEMPLAZAR_CON_SERVER_API_TOKEN_DE_POSTMARK
EMAIL_HOST_PASSWORD=REEMPLAZAR_CON_EL_MISMO_SERVER_API_TOKEN
DEFAULT_FROM_EMAIL=Bold App <remitente-individual-verificado@bold.gt>

# Token del tunel administrado; se obtiene en el dashboard de Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=REEMPLAZAR_CON_TOKEN_DEL_TUNEL
