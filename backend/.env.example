# Copia este archivo a .env y ajusta los valores para desarrollo local.
# En Render, estas variables las provee automaticamente render.yaml (ver
# ese archivo en la raiz del repo) — no hace falta cargarlas a mano ahi.

SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Si se omite, el proyecto usa SQLite localmente.
# En Render, este valor lo provee automaticamente el servicio de PostgreSQL.
DATABASE_URL=postgres://user:password@localhost:5432/boldapp

# Redis: broker/backend de Celery (webhooks salientes) Y channel layer de
# Django Channels (push en vivo por WebSocket). Celery puede correr sin
# Redis en desarrollo (modo "eager", sincrono) si se omite esta variable,
# pero el channel layer SIEMPRE necesita un Redis real corriendo, incluso
# en desarrollo local (`redis-server` o un contenedor).
# En Render lo provee el servicio de Key Value (bold-app-redis).
REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false

# Autenticacion. Usa un secreto largo y aleatorio, distinto de SECRET_KEY.
AUTH_ENCRYPTION_KEY=
AUTH_SESSION_COOKIE_NAME=bold_session
AUTH_SESSION_TIME_ZONE=America/Guatemala
AUTH_SESSION_CUTOFF_TIME=07:00
# 0 deshabilita el cierre por inactividad; el corte diario sigue activo.
AUTH_SESSION_IDLE_SECONDS=0
AUTH_SESSION_COOKIE_SAMESITE=Lax
AUTH_MFA_REQUIRED=false
AUTH_CHALLENGE_TTL_SECONDS=3600
AUTH_INVITATION_TTL_SECONDS=259200
AUTH_WEBSOCKET_TICKET_TTL_SECONDS=45
AUTH_NUM_PROXIES=0
ADMIN_STEP_UP_MFA_SECONDS=600
# Solo para desarrollo: agrega luis@bold.gt (dueño) y paulus@bold.gt (alta gerencia).
SEED_PRIVILEGED_DEMO_ACCOUNTS=false
FRONTEND_URL=http://localhost:5174
DEFAULT_FROM_EMAIL=no-reply@bold.gt
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
