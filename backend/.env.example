# Copia este archivo a .env y ajusta los valores para desarrollo local.
# En Render, estas variables se configuran desde el panel del servicio.

SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Si se omite, el proyecto usa SQLite localmente.
# En Render, este valor lo provee automaticamente el addon de PostgreSQL.
DATABASE_URL=postgres://user:password@localhost:5432/boldapp

# Broker/backend de Celery para la entrega asincrona de webhooks.
# En Render lo provee el addon de Redis. En local, si se omite y DEBUG=true,
# las tareas corren en modo "eager" (sincrono, sin necesitar Redis).
REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
