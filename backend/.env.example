# Copia este archivo a .env y ajusta los valores para desarrollo local.
# En Render, estas variables las provee automaticamente render.yaml (ver
# ese archivo en la raiz del repo) — no hace falta cargarlas a mano ahi.

SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Si se omite, el proyecto usa SQLite localmente.
# En Render, este valor lo provee automaticamente el servicio de PostgreSQL.
DATABASE_URL=postgres://user:password@localhost:5432/boldapp

# Redis: broker/backend de Celery (webhooks salientes) Y channel layer de
# Django Channels (push en vivo por WebSocket). Celery puede correr sin
# Redis en desarrollo (modo "eager", sincrono) si se omite esta variable,
# pero el channel layer SIEMPRE necesita un Redis real corriendo, incluso
# en desarrollo local (`redis-server` o un contenedor).
# En Render lo provee el servicio de Key Value (bold-app-redis).
REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false
