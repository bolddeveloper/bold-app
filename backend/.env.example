# Desarrollo local. Para Oracle usa deploy/oracle/.env.oracle.example.
SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
USE_X_FORWARDED_HOST=false
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Si se omite, Django usa SQLite local.
# DATABASE_URL=postgres://user:password@localhost:5432/boldapp

# Redis comparte la cola Celery y la capa de Channels. Sin REDIS_URL, Celery
# corre eager y Channels usa memoria solamente para desarrollo de un proceso.
# REDIS_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=false

AUTH_ENCRYPTION_KEY=
AUTH_SESSION_COOKIE_NAME=bold_session
AUTH_SESSION_TIME_ZONE=America/Guatemala
AUTH_SESSION_CUTOFF_TIME=07:00
AUTH_SESSION_IDLE_SECONDS=0
AUTH_SESSION_COOKIE_SAMESITE=Lax
AUTH_MFA_REQUIRED=false
AUTH_CHALLENGE_TTL_SECONDS=3600
AUTH_INVITATION_TTL_SECONDS=259200
AUTH_WEBSOCKET_TICKET_TTL_SECONDS=45
AUTH_NUM_PROXIES=0
TRUST_CLOUDFLARE_CONNECTING_IP=false
ADMIN_STEP_UP_MFA_SECONDS=600
ADMIN_TEMPORARY_PASSWORD_ENABLED=false
PERMISSIONS_STEP_UP_MFA_SECONDS=600
PERMISSIONS_AUTHORITY_MAX_SECONDS=7776000

SEED_DEMO_ACCOUNTS=true
SEED_PRIVILEGED_DEMO_ACCOUNTS=false
FRONTEND_URL=http://localhost:5174

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@bold.gt
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# Google: cliente OAuth web común; alternativa inicial al JSON en Conectores.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=http://localhost:8000/api/v2/workspace/oauth/callback/
GOOGLE_WORKSPACE_COMPANY_DOMAIN=bold.gt

# Editores propios activos; usar false para reactivar el visor publicado.
GOOGLE_WORKSPACE_EDITORS_ENABLED=true
