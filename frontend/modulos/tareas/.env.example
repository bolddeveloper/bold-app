# Copia este archivo a .env para configurar el cliente.

# Por defecto la app usa datos de plantilla en memoria (task_data.js), sin
# tocar la red — es el modo usado para la demo mientras el backend real no
# esta desplegado con Postgres/Redis. Pone esto en "true" para volver a usar
# la API real de boldApp; ese camino ya esta implementado y probado en
# services/api_client.js, asi que el cambio es solo esta variable.
VITE_USE_REAL_BACKEND=false

# Las siguientes solo aplican cuando VITE_USE_REAL_BACKEND=true.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Deben coincidir con lo que crea `python manage.py seed_demo_data` en el backend.
VITE_DEMO_WORKSPACE_NAME=Bold Demo
VITE_DEMO_USER_EMAIL=ana@bold.gt
