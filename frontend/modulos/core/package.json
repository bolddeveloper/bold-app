{
    "name": "bold-app-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "postinstall": "node tools/patch_casual_sheets.mjs && node tools/ensure_dependencies.mjs --record",
        "predev": "node tools/ensure_dependencies.mjs",
        "dev": "vite --configLoader runner --host 0.0.0.0 --force",
        "prebuild": "node tools/ensure_dependencies.mjs",
        "build": "vite build --configLoader runner",
        "preview": "vite preview --configLoader runner --host 0.0.0.0",
        "test": "node --test shared/image_controls.test.js shared/bold_dialog.test.js shared/presence.test.js shared/people.test.js startup_greeting.test.js keyboard_shortcuts.test.js google_cache.test.js module_cache.test.js onboarding*.test.js ../tareas/src/*.test.js ../tareas/src/services/*.test.js ../marcas/*.test.js ../docs/*.test.js ../calendario/*.test.js ../notificaciones/*.test.js ../perfil/release_notes.test.js ../hojas/*.test.js",
        "test:pwa": "node --test pwa_updates.test.js",
        "test:brands-ui": "node tests/brands_ui.mjs",
        "test:header-calendar-ui": "node tests/header_calendar_ui.mjs",
        "test:comment-editor-ui": "node tests/comment_editor_ui.mjs",
        "test:worker": "node --test worker/*.test.js",
        "check:sync-capacity": "node tools/check_sync_capacity.mjs",
        "probe:public-health": "node tools/probe_public_health.mjs",
        "deploy:cloudflare": "npm run build && wrangler deploy"
    },
    "dependencies": {
        "@casualoffice/sheets": "0.20.0",
        "@hocuspocus/provider": "2.15.3",
        "@univerjs/core": "0.25.0",
        "@univerjs/data-validation": "0.25.0",
        "@univerjs/design": "0.25.0",
        "@univerjs/docs": "0.25.0",
        "@univerjs/docs-ui": "0.25.0",
        "@univerjs/drawing": "0.25.0",
        "@univerjs/drawing-ui": "0.25.0",
        "@univerjs/engine-formula": "0.25.0",
        "@univerjs/engine-render": "0.25.0",
        "@univerjs/find-replace": "0.25.0",
        "@univerjs/rpc": "0.25.0",
        "@univerjs/sheets": "0.25.0",
        "@univerjs/sheets-conditional-formatting": "0.25.0",
        "@univerjs/sheets-conditional-formatting-ui": "0.25.0",
        "@univerjs/sheets-data-validation": "0.25.0",
        "@univerjs/sheets-data-validation-ui": "0.25.0",
        "@univerjs/sheets-drawing": "0.25.0",
        "@univerjs/sheets-drawing-ui": "0.25.0",
        "@univerjs/sheets-filter": "0.25.0",
        "@univerjs/sheets-filter-ui": "0.25.0",
        "@univerjs/sheets-find-replace": "0.25.0",
        "@univerjs/sheets-formula": "0.25.0",
        "@univerjs/sheets-formula-ui": "0.25.0",
        "@univerjs/sheets-hyper-link": "0.25.0",
        "@univerjs/sheets-hyper-link-ui": "0.25.0",
        "@univerjs/sheets-note": "0.25.0",
        "@univerjs/sheets-note-ui": "0.25.0",
        "@univerjs/sheets-numfmt": "0.25.0",
        "@univerjs/sheets-numfmt-ui": "0.25.0",
        "@univerjs/sheets-sort": "0.25.0",
        "@univerjs/sheets-sort-ui": "0.25.0",
        "@univerjs/sheets-table": "0.25.0",
        "@univerjs/sheets-table-ui": "0.25.0",
        "@univerjs/sheets-thread-comment": "0.25.0",
        "@univerjs/sheets-thread-comment-ui": "0.25.0",
        "@univerjs/sheets-ui": "0.25.0",
        "@univerjs/themes": "0.25.0",
        "@univerjs/thread-comment": "0.25.0",
        "@univerjs/thread-comment-ui": "0.25.0",
        "@univerjs/ui": "0.25.0",
        "driver.js": "^1.8.0",
        "lucide-react": "^0.562.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "rxjs": "7.8.2",
        "sweetalert2": "^11.26.25",
        "yjs": "13.6.27"
    },
    "overrides": {
        "echarts": "6.1.0",
        "nanoid": "5.1.16"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.1",
        "jsdom": "26.1.0",
        "vite": "^7.3.0",
        "wrangler": "^4.143.0"
    }
}
