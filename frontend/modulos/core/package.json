{
    "name": "bold-app-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --configLoader runner --host 0.0.0.0",
        "build": "vite build --configLoader runner",
        "preview": "vite preview --configLoader runner --host 0.0.0.0",
        "test": "node --test shared/image_controls.test.js shared/bold_dialog.test.js shared/presence.test.js keyboard_shortcuts.test.js google_cache.test.js onboarding*.test.js ../tareas/src/*.test.js ../tareas/src/services/*.test.js ../docs/*.test.js ../calendario/*.test.js ../notificaciones/*.test.js",
        "test:worker": "node --test worker/*.test.js",
        "check:sync-capacity": "node tools/check_sync_capacity.mjs",
        "probe:public-health": "node tools/probe_public_health.mjs",
        "deploy:cloudflare": "npm run build && wrangler deploy"
    },
    "dependencies": {
        "driver.js": "^1.8.0",
        "lucide-react": "^0.562.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "sweetalert2": "^11.26.25"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.1.1",
        "vite": "^7.3.0",
        "wrangler": "^4.143.0"
    }
}
