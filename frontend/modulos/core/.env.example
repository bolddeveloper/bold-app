# false: plantilla local; true: API REST y WebSocket V2 para los módulos.
VITE_USE_REAL_BACKEND=false
# Vacío usa el mismo origen y el proxy de Vite; en producción usa la URL pública del backend.
VITE_API_BASE_URL=
# Diagnóstico agregado local; no envía métricas ni registra datos de usuarios.
# Con true, usar window.boldSyncDiagnostics.snapshot() en la consola.
VITE_SYNC_DIAGNOSTICS=false
VITE_APP_VERSION=local
# Respaldo de contenido; no modifica la revisión de seguridad. Mínimo 60000.
VITE_TASK_RECONCILE_MS=300000
VITE_PERMISSION_CONTROL_ENABLED=true
# En Cloudflare Pages configura:
# VITE_USE_REAL_BACKEND=true
# VITE_API_BASE_URL=https://api.bold.gt
# Fase 3; activar solo después de desplegar los filtros compatibles del backend.
VITE_TASK_INCREMENTAL_SYNC=true
# Historial por vista: requiere backend con recent=1 y cursor compuesto.
# Activar en el build después de publicar primero ese backend; false revierte al cliente anterior.
VITE_TASK_PAGED_COMMENTS=false
