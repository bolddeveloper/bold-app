{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "boldapp",
    "main": "./worker/index.js",
    "compatibility_date": "2026-09-28",
    "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/ws/*",
            "/health*"
        ]
    },
    "vpc_services": [
        {
            "binding": "BACKEND",
            "service_id": "01a0e8fd-3042-7c90-a354-3e5dc861a3f7",
            "remote": true
        }
    ]
}
